diff --git a/doomgeneric/i_video.c b/doomgeneric/i_video.c
index 84bebde..488f516 100644
--- a/doomgeneric/i_video.c
+++ b/doomgeneric/i_video.c
@@ -185,6 +185,11 @@ void cmap_to_fb(uint8_t *out, uint8_t *in, int in_pixels)
                   (c.g << s_Fb.green.offset) |
                   (c.b << s_Fb.blue.offset);
 
+            /* doom.epub: keep the framebuffer fully opaque for ImageData. */
+            if (s_Fb.transp.offset == 24 && s_Fb.transp.length == 8) {
+                pix |= (0xffu << 24);
+            }
+
 #ifdef SYS_BIG_ENDIAN
             pix = swapLE32(pix);
 #endif
@@ -239,9 +244,14 @@ void I_InitGraphics (void)
 		s_Fb.red.length = 8;
 		s_Fb.transp.length = 8;
 
-		s_Fb.blue.offset = 0;
+		/* doom.epub: the host wraps this buffer directly in an HTML
+		 * canvas ImageData, whose bytes are R,G,B,A in memory order.
+		 * On little-endian hosts the default 0xAARRGGBB packing would
+		 * put B in the first byte, swapping red and blue.  Pack
+		 * 0xAABBGGRR instead so memory reads R,G,B,A. */
+		s_Fb.red.offset = 0;
 		s_Fb.green.offset = 8;
-		s_Fb.red.offset = 16;
+		s_Fb.blue.offset = 16;
 		s_Fb.transp.offset = 24;
 	}
 
